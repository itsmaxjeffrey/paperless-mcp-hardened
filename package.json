{
  "name": "@itsmaxjeffrey/paperless-mcp-hardened",
  "version": "1.6.1-hardened.1",
  "description": "Security-hardened fork of the Paperless-ngx Model Context Protocol server: documents, organization, saved views, users, workflows, and optional semantic search. Fork of @orellbuehler/paperless-mcp by Orell B\u00fchler (MIT).",
  "type": "module",
  "bin": {
    "paperless-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "!dist/__tests__"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "spec:update": "bash scripts/update-openapi.sh",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "paperless",
    "paperless-ngx",
    "document-management",
    "semantic-search",
    "claude",
    "llm",
    "ai",
    "ai-agents"
  ],
  "author": "Orell B\u00fchler (upstream); hardened fork maintained by Max Jeffrey",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itsmaxjeffrey/paperless-mcp-hardened.git"
  },
  "homepage": "https://github.com/itsmaxjeffrey/paperless-mcp-hardened#readme",
  "bugs": {
    "url": "https://github.com/itsmaxjeffrey/paperless-mcp-hardened/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "pdf-lib": "^1.17.1",
    "unpdf": "^1.8.1",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.11.1",
    "sqlite-vec": "^0.1.9"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.20.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "minimatch@>=7 <11.0.1": "11.0.1"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  },
  "private": true
}
